{
  "name": "forma-skeleton",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/config",
    "tools/create-forma-app",
    "packages/identity-boundary",
    "packages/identity-lifecycle"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test packages/config/test/*.test.mjs && npm run test --workspace create-forma-app && npm run test:templates",
    "check:config": "node packages/config/src/check.mjs",
    "build:cli": "npm run build --workspace create-forma-app",
    "test:consumer": "node tests/blueprint-consumers/run-neutral.mjs",
    "test:visual": "node tests/blueprint-consumers/run-visual.mjs",
    "test:python-package": "python3 tests/blueprint-consumers/verify-python-package.py",
    "test:identity-boundary": "npm run test --workspace @forma/identity-boundary-proof",
    "test:templates": "node --test blueprints/application/frontend/test/*.test.mjs && python3 -m unittest discover -s blueprints/application/backend/tests -p test_api.py",
    "test:identity-lifecycle": "npm run test --workspace @forma/identity-lifecycle-proof",
    "test:navigation": "node tests/blueprint-consumers/run-navigation.mjs",
    "test:auth-presentation": "node tests/blueprint-consumers/run-auth-presentation.mjs",
    "test:presentation-accessibility": "node tests/blueprint-consumers/run-presentation-accessibility.mjs",
    "test:theme-contract": "node tests/blueprint-consumers/run-theme-contract.mjs",
    "test:authenticated-consumer": "node tests/blueprint-consumers/run-authenticated.mjs"
  },
  "devDependencies": {
    "ajv": "8.20.0",
    "nodemailer": "10.2.1",
    "playwright": "1.64.1",
    "prettier": "3.6.2",
    "qrcode": "1.5.4"
  }
}

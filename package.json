{
  "name": "forma-skeleton",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/config",
    "tools/create-forma-app"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test packages/config/test/*.test.mjs && npm run test --workspace create-forma-app",
    "check:config": "node packages/config/src/check.mjs",
    "build:cli": "npm run build --workspace create-forma-app",
    "test:consumer": "node tests/blueprint-consumers/run-neutral.mjs",
    "test:visual": "node tests/blueprint-consumers/run-visual.mjs",
    "test:python-package": "python3 tests/blueprint-consumers/verify-python-package.py"
  },
  "devDependencies": {
    "playwright": "1.64.1",
    "prettier": "3.6.2"
  }
}

{
  "schemaVersion": 1,
  "id": "forma.application",
  "version": "0.1.0",
  "compatibleGenerator": "0.1.x",
  "requiredModules": ["presentation", "localization", "navigation", "records"],
  "source": [],
  "capabilities": {
    "authModes": ["none", "password"],
    "providers": [],
    "twoFactor": true,
    "extensions": false
  },
  "modules": [
    {
      "id": "presentation",
      "kind": "foundation",
      "version": "0.1.0",
      "requires": [],
